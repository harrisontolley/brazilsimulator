; Engine configuration file.
config_version=5

[application]

config/name="Brazil Simulator"
config/version="0.1.2"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

driver/enable_input=true

[autoload]

Controls="*res://autoload/controls.gd"
DB="*res://autoload/db.gd"
Net="*res://autoload/net.gd"
MatchState="*res://autoload/match_state.gd"
Crime="*res://autoload/crime.gd"
Mic="*res://autoload/mic.gd"
Sfx="*res://autoload/sfx.gd"
Settings="*res://autoload/settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=120

[rendering]

anti_aliasing/quality/msaa_3d=2
